// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://niri-wm.github.io/niri/Configuration:-Window-Rules

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
/-window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}


workspace "1" { open-on-output "DP-1"; }
workspace "2" { open-on-output "DP-1"; }
workspace "3" { open-on-output "DP-1"; }
workspace "4" { open-on-output "DP-1"; }
workspace "5" { open-on-output "HDMI-A-1"; }
workspace "6" { open-on-output "DP-1"; }
workspace "7" { open-on-output "DP-1"; }
workspace "8" { open-on-output "DP-1"; }
workspace "9" { open-on-output "DP-1"; }


window-rule {
    match app-id="^kitty$"
    draw-border-with-background false
}

window-rule {
    match at-startup=true app-id="^kitty$"
    open-on-workspace "2"
}

window-rule {
  match app-id=r#"(?x)^(
      chromium-browser
      |md.obsidian.Obsidian
      |Minecraft
      |libreoffice-writer
      |DBeaver
      |steam
      |steam_app_250900
      |Mindustry
      |dev.zed.Zed
      |org.telegram.desktop
      |vesktop
      |zathura
      |com.obsproject.Studio
      |Spotify
      |org.telegram.desktop
      |com.obsproject.Studio
    )$"#

    open-maximized true
}

// Enable rounded corners for all windows.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Workspace 1 — браузер
window-rule {
    match at-startup=true app-id="^chromium-browser$"
    open-on-workspace "1"
}


// Workspace 3 — заметки и PDF
window-rule {
    match app-id="md.obsidian.Obsidian"
    open-on-workspace "3"
}

window-rule {
    match app-id="zathura"
    open-on-workspace "3"
}

// Workspace 4 — OBS
window-rule {
    match app-id="com.obsproject.Studio"
    open-on-workspace "4"
}

// Workspace 5 — мессенджеры
window-rule {
    match app-id="org.telegram.desktop"
    open-on-workspace "5"
}

window-rule {
    match app-id="vesktop"
    open-on-workspace "5"
}

// Workspace 7 — игры
window-rule {
	match app-id="osu!"
	open-on-workspace "7"
}

// Workspace 8 — музыка
window-rule {
    match app-id="Spotify"
    open-on-workspace "8"
}

